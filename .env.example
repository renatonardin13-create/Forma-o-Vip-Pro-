# ==============================================================================
# FORMAÇÃO VIP PRO — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vercel / Vite - Client-side)
# Apenas estas variáveis possuem o prefixo VITE_ e são expostas ao navegador.
# NUNCA inclua chaves secretas ou tokens aqui.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 2. SERVER ONLY / EDGE FUNCTIONS (Supabase Secrets / Backend)
# NUNCA adicione o prefixo VITE_ nestas variáveis.
# Estas variáveis devem ser configuradas exclusivamente no painel do Supabase
# (Project Settings -> Edge Functions -> Secrets) ou em ambiente server seguro.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret_key_exclusiva_supabase
RESEND_API_KEY=sua_chave_resend_para_emails_transacionais
KIWIFY_WEBHOOK_TOKEN=seu_token_secreto_configurado_na_kiwify
PERFECTPAY_WEBHOOK_TOKEN=seu_token_secreto_configurado_na_perfectpay

# URL de login da aplicação para links nos e-mails transacionais enviados pelo Edge Function
APP_LOGIN_URL=https://membros.formacaovip.pro/login

# ------------------------------------------------------------------------------
# 3. AI STUDIO / CLOUD RUN METADATA (Opcional no runtime do Google AI Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
APP_URL=
